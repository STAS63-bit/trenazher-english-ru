#!/bin/sh
# Замок перед коммитом: проверка тренажёра. Включается один раз командой
#   git config core.hooksPath .githooks
# Стоп — коммит не пройдёт, пока не исправишь или не запустишь проверку с --force "причина" вручную.
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 check.py || {
  echo ""
  echo "Коммит остановлен проверкой. Исправь или, если изменение намеренное:"
  echo "  python3 check.py --force \"что и зачем убрала\"  и потом  git commit --no-verify"
  exit 1
}
